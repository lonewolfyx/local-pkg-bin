{
  "name": "local-pkg-bin",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.2",
  "description": "Easily retrieve the absolute paths of executable binaries provided by your project's local npm packages",
  "author": "lonewolfyx",
  "license": "MIT",
  "homepage": "https://github.com/lonewolfyx/local-pkg-bin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonewolfyx/local-pkg-bin.git"
  },
  "bugs": {
    "url": "https://github.com/lonewolfyx/local-pkg-bin/issues"
  },
  "keywords": [
    "package"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "prepublishOnly": "pnpm build",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "local-pkg": "^1.1.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@lonewolfyx/tsconfig": "^0.0.6",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "jiti": "^2.7.0",
    "nano-staged": "^1.0.2",
    "picocolors": "^1.1.1",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "simple-git-hooks": {
    "pre-commit": "npx nano-staged",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "nano-staged": {
    "*": "eslint --fix"
  }
}